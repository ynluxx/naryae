    .toast{position:fixed;bottom:84px;left:50%;transform:translateX(-50%) translateY(120px);width:max-content;max-width:calc(100vw - 32px);background:var(--deep);color:#f1f6ef;padding:12px 14px 12px 18px;border-radius:18px;border:2px solid var(--clover);box-shadow:0 10px 30px rgba(0,0,0,.3);z-index:100;font-weight:600;font-size:15px;display:flex;align-items:center;gap:12px;opacity:0;transition:transform .3s ease,opacity .3s ease;pointer-events:none}
