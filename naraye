      .cta{flex-wrap:nowrap}.cta .btn{width:auto;flex:1 1 0;min-height:44px;padding:10px 12px;font-size:15px;text-align:center}.cta .btn:nth-child(3){display:none}
      .stats{gap:0;justify-content:space-between;margin-top:20px}.stats strong{font-size:26px}.stats li>span{font-size:12px;max-width:92px;line-height:1.25}
      .marquee{padding:8px 0;font-size:14px}
      .tools{gap:10px;margin-bottom:6px}
