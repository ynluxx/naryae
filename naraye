    @keyframes bump{0%,100%{transform:scale(1)}40%{transform:scale(1.18)}}
    .cart-pill{display:none;align-items:center;gap:6px;margin-left:auto;margin-right:12px;padding:8px 14px;border-radius:999px;background:var(--clover);color:#0d2415;text-decoration:none;font-weight:600}
    @media(prefers-reduced-motion:reduce){.card.flash,.fab a.bump,.patch>*,.deco,.track,.card.pop{animation:none!important}.toast,.btn::after,.card{transition:none}.reveal{opacity:1;transform:none;transition:none}.progress{display:none}}@media(max-width:700px){.patch>.deco{display:none}}
