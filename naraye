    .toast-icon{display:grid;place-items:center;flex:none;width:28px;height:28px;border-radius:50%;background:var(--clover);color:#0d2415;font-size:16px}
    .toast-link{flex:none;background:var(--clover);color:#0d2415;padding:8px 14px;border-radius:999px;text-decoration:none;font-size:14px}
    .btn.added{background:#143d20;color:#fff}
