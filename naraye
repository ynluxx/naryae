  b._t=setTimeout(()=>{b.textContent='Agregar al carrito';b.classList.remove('added')},2500);
  c.classList.remove('flash');void c.offsetWidth;c.classList.add('flash');flyToCart(b,()=>{fab.classList.remove('bump');void fab.offsetWidth;fab.classList.add('bump')});
  showToast(`${qty}x ${name} agregado · ${total} ${total===1?'producto':'productos'} en tu carrito`);
}

/* ===== EVENTOS ===== */
document.addEventListener('change',e=>{if(e.target.matches('.size,.qty,.custom'))updatePrice(e.target)});
document.addEventListener('click',e=>{
  const b=e.target.closest('.add');
  if(b){
    const c=b.closest('.card'),s=c.querySelector('.size'),p=JSON.parse(c.dataset.prices),qty=+c.querySelector('.qty').value,custom=c.querySelector('.custom')?.checked||false;
    const price=((p[+s.value]??p[0]??0)+(custom?+c.dataset.custom:0))*qty;
    cart.push({name:c.dataset.name,size:s.selectedOptions[0].text,qty,price,customLabel:custom?c.querySelector('.custom').parentElement.textContent.trim().replace(/\s*\(\+.*\)$/,''):''});
    renderCart();
    confirmAdd(b,c,qty);
    return;
  }
  if(e.target.dataset.remove!==undefined){cart.splice(+e.target.dataset.remove,1);renderCart()}
  if(e.target.id==='clear-cart-btn'){cart=[];renderCart()}
  if(e.target.closest('.faq-question')){const f=e.target.closest('.faq-item');document.querySelectorAll('.faq-item.is-open').forEach(o=>{if(o!==f){o.classList.remove('is-open');o.querySelector('button').setAttribute('aria-expanded','false')}});f.classList.toggle('is-open');f.querySelector('button').setAttribute('aria-expanded',f.classList.contains('is-open'))}
});

$('q').addEventListener('input',renderCatalog);
$('ind-tabs').addEventListener('click',e=>{const b=e.target.closest('[data-ind]');if(b){indFilter=b.dataset.ind;renderIndTabs()}});
$('tabs').addEventListener('click',e=>{const b=e.target.closest('[data-cat]');if(b){categoryFilter=b.dataset.cat;renderCatalog()}});

// Formulario: el error se borra al escribir y al enviar con éxito
['f-name','f-msg'].forEach(id=>$(id).addEventListener('input',()=>{$('err').textContent=''}));
$('quote-form').addEventListener('submit',e=>{
  e.preventDefault();
  const name=$('f-name').value.trim();
  if(!name||!cart.length){$('err').textContent=!name?'Escribe tu nombre.':'Tu carrito está vacío.';return}
  $('err').textContent='';
  const text=`¡Hola Naryae®! Soy ${name} y quiero cotizar:\n`+cart.map(x=>`${x.qty}x ${x.name} (${x.size}) - ${money(x.price)}`).join('\n')+`\nTotal estimado: ${money(cart.reduce((a,x)=>a+x.price,0))}\n${$('f-msg').value}`;
  window.open('https://wa.me/56934486112?text='+encodeURIComponent(text),'_blank','noopener,noreferrer');
});

$('burger').addEventListener('click',()=>{const open=$('nav').classList.toggle('open');$('burger').setAttribute('aria-expanded',String(open));$('burger').setAttribute('aria-label',open?'Cerrar menú':'Abrir menú')});
$('nav').addEventListener('click',e=>{if(e.target.closest('a')){$('nav').classList.remove('open');$('burger').setAttribute('aria-expanded','false')}});

/* ===== CALCULADORA ===== */
const modal=$('size-modal'),calcType=$('calc-type'),calcValue=$('calc-value'),calcOutput=$('calc-output');
const heightLimits=[[108,'Talla 4'],[116,'Talla 6'],[124,'Talla 8'],[132,'Talla 10'],[140,'Talla 12'],[148,'Talla 14'],[158,'Talla 16'],[166,'Talla S Adulto'],[174,'Talla M Adulto'],[182,'Talla L Adulto']];

function syncCalcType(){
  const school=calcType.value==='school';
  $('calc-label').textContent=school?'Estatura de la persona (cm)':'Ancho de pecho en plano (cm)';
  $('calc-hint').textContent=school?'Mide la estatura de la persona sin zapatos.':'Ancho de lado a lado de una prenda cómoda, no el contorno.';
  calcValue.min=school?'80':'25';calcValue.max=school?'210':'80';calcValue.step=school?'1':'0.5';
  calcValue.placeholder=school?'Ej.: 128':'Ej.: 36';calcValue.value='';
  calcOutput.textContent='Ingresa una medida para sugerir la talla.';
}
calcType.addEventListener('change',syncCalcType);
$('open-size-guide').addEventListener('click',()=>{modal.classList.add('open');modal.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';$('close-size-modal').focus()});
function closeCalc(){modal.classList.remove('open');modal.setAttribute('aria-hidden','true');document.body.style.overflow='';$('open-size-guide').focus()}
$('close-size-modal').addEventListener('click',closeCalc);
modal.addEventListener('click',e=>{if(e.target===modal)closeCalc()});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))closeCalc()});

calcValue.addEventListener('input',()=>{
  const v=Number(calcValue.value),school=calcType.value==='school';
  if(!calcValue.value){calcOutput.textContent='Ingresa una medida para sugerir la talla.';return}
  if(!Number.isFinite(v)||v<Number(calcValue.min)||v>Number(calcValue.max)){calcOutput.textContent=`Ingresa una medida válida entre ${calcValue.min} y ${calcValue.max} cm.`;return}
  let label;
  if(school){
    label=(heightLimits.find(([lim])=>v<lim)||[0,'Talla XL / XXL'])[1];
  }else{
    // Talla de la tabla (SZ) con el ancho más cercano; si queda justo entre dos, se elige la mayor
    let best=SZ[0];
    for(const t of SZ){if(Math.abs(t[1]-v)<=Math.abs(best[1]-v))best=t}
    label=best[0];
  }
  calcOutput.innerHTML=`✨ Sugerencia orientativa: <strong>${label}</strong><br><small style="font-weight:400;color:var(--muted)">La talla puede variar según modelo y ajuste. Confírmala al cotizar.</small>`;
});

const reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;

// Trébol que vuela desde el botón hasta el carrito
function flyToCart(from,done){
  if(reduced){done();return}
  const a=from.getBoundingClientRect(),t=$('fab-link').getBoundingClientRect(),el=document.createElement('span');
  el.textContent='🍀';el.setAttribute('aria-hidden','true');
  el.style.cssText=`position:fixed;left:${a.left+a.width/2-14}px;top:${a.top+a.height/2-14}px;font-size:28px;z-index:120;pointer-events:none`;
  document.body.appendChild(el);
  const dx=t.left+t.width/2-(a.left+a.width/2),dy=t.top+t.height/2-(a.top+a.height/2);
  el.animate([{transform:'translate(0,0) scale(1) rotate(0)',opacity:1},{transform:`translate(${dx*.5}px,${dy*.5-60}px) scale(1.4) rotate(180deg)`,opacity:1,offset:.5},{transform:`translate(${dx}px,${dy}px) scale(.4) rotate(360deg)`,opacity:.3}],{duration:750,easing:'ease-in-out'}).onfinish=()=>{el.remove();done()};
}

function countUp(el,to,suffix=''){
  if(reduced){el.textContent=to+suffix;return}
  const t0=performance.now();
  (function f(t){const k=Math.min(1,(t-t0)/1200);el.textContent=Math.round(to*(1-Math.pow(1-k,3)))+suffix;if(k<1)requestAnimationFrame(f)})(t0);
}

document.addEventListener('animationend',e=>{if(e.animationName==='pop'){e.target.classList.remove('pop');e.target.style.animationDelay=''}});

function initEffects(){
  // Barra de progreso y sombra del encabezado
  const hdr=document.querySelector('header'),prog=$('progress');
  const onScroll=()=>{const max=document.documentElement.scrollHeight-innerHeight;prog.style.transform=`scaleX(${max>0?Math.min(1,scrollY/max):0})`;hdr.classList.toggle('scrolled',scrollY>10)};
  addEventListener('scroll',onScroll,{passive:true});onScroll();
  // Contadores del inicio
  countUp($('n-years'),Math.max(1,new Date().getFullYear()-2020),'+');
  countUp($('n-schools'),schools.length);
  if(!('IntersectionObserver' in window))return;
  // Menú: marca la sección en la que estás
  const links=[...document.querySelectorAll('#nav a')];
  const secObs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)links.forEach(a=>a.setAttribute('aria-current',String(a.getAttribute('href')==='#'+e.target.id)))}),{rootMargin:'-45% 0px -50% 0px'});
  links.forEach(a=>{const t=document.querySelector(a.getAttribute('href'));if(t)secObs.observe(t)});
  // Aparición suave al hacer scroll
  if(reduced)return;
  const mob=matchMedia('(max-width:700px)').matches;
  const els=document.querySelectorAll('section h2,section .lead,.faq-item,.about-text p,.quote,.contact>*'+(mob?'':',.review-card,#schools-grid .card,#individual-grid .card'));
  const obs=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;e.target.classList.add('in');obs.unobserve(e.target);setTimeout(()=>e.target.classList.remove('reveal','in'),900)}),{threshold:.12});
  els.forEach((el,i)=>{el.style.setProperty('--d',(i%4)*.08+'s');el.classList.add('reveal');obs.observe(el)});
}

$('yr').textContent=new Date().getFullYear();
renderStatic();renderCatalog();renderCart();initEffects();
})();
</script>
