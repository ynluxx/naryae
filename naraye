flex;flex-direction:column;gap:14px;margin-top:24px;max-width:800px}.faq-item{padding:0;overflow:hidden}.faq-question{width:100%;padding:16px;text-align:left;background:white;border:0;font:600 17px 'DM Sans',sans-serif;cursor:pointer}.faq-answer{display:none;padding:0 16px;color:var(--muted)}.faq-item.is-open .faq-answer{display:block}.review-card{display:flex;flex-direction:column;gap:8px}.review-card p{margin:0;color:var(--muted)}.review-stars{color:#f5b400;font-size:21px;letter-spacing:2px}.review-author{display:block;margin-top:auto;font-weight:700;font-size:14px}.about{display:grid;grid-template-columns:1.2fr 1fr;gap:44px;align-items:center}.about-text p{margin:0 0 16px;color:var(--muted);font-size:16px}.quote{border:3px dashed var(--clover);border-radius:24px;padding:34px 28px;text-align:center;background:rgba(92,203,71,.04)}.quote .script{font-size:46px;color:var(--green);line-height:1.1}.fab{position:fixed;bottom:16px;right:16px;z-index:30}.fab a{background:#25d366;padding:14px 20px;border-radius:30px;text-decoration:none;color:#08331b;font-weight:600}footer{background:var(--deep);color:#d4e2d2;padding:30px}.modal-overlay{position:fixed;inset:0;background:#0009;z-index:50;display:none;place-items:center;padding:16px}.modal-overlay.open{display:grid}.modal-content{background:white;border-radius:18px;padding:24px;max-width:600px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 20px 40px #0003}.modal-close{float:right;background:none;border:0;font-size:22px;cursor:pointer}.calc-box{padding:16px;background:var(--soft);border-radius:12px}.calc-result{margin-top:12px;background:white;padding:14px;text-align:center;border-radius:8px;min-height:56px;color:var(--green);font-weight:700}.modal-note{background:white;padding:12px;border:1px solid var(--line);border-radius:8px;color:var(--muted);font-size:13px}
    /* ===== Efectos visuales ===== */
    .progress{position:fixed;top:0;left:0;width:100%;height:4px;background:var(--clover);transform-origin:0 50%;transform:scaleX(0);z-index:90;pointer-events:none}
